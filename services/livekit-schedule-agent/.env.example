LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Claude (the sole thinking engine) ---------------------------------------
# ANTHROPIC_API_KEY goes in .env.local (NOT here). Optional knobs (defaults shown):
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_TEMPERATURE=0.3
# Bound a stalled Claude call so a hung turn fails fast to deterministic answers
# instead of stacking framework retries:
# ANTHROPIC_ATTEMPT_TIMEOUT=8.0
# ANTHROPIC_MAX_RETRY=1

# Turn-taking: lower = snappier replies, too low risks cutting the speaker off.
# These are also auto-tuned nightly from metrics; env vars act as manual overrides.
VAD_MIN_SILENCE=0.45
MIN_ENDPOINTING_DELAY=0.4
MAX_ENDPOINTING_DELAY=5.0

# Where the agent forwards per-turn timing metrics that feed the auto-tuner.
VOICE_METRICS_URL=http://127.0.0.1:4652/api/livekit/metrics

LOCAL_SPEECH_BASE_URL=http://127.0.0.1:8000/v1
# Whisper is the STT FALLBACK now (Parakeet is primary — see below). Must be
# NON-distilled: distil-whisper ignores the vocabulary prompt Myra sends for
# campaign/character names, and destabilizes on a long one.
LOCAL_STT_MODEL=Systran/faster-whisper-small.en
LOCAL_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
LOCAL_TTS_VOICE=af_heart

# --- ElevenLabs TTS (optional, hosted) ---------------------------------------
# Opt in to ElevenLabs Flash v2.5 as Myra's PRIMARY voice, with local Kokoro kept
# as an automatic fallback floor (an outage / spent credits drops to Kokoro, not
# silence). Leave MYRA_TTS unset for the default all-local Kokoro path.
#   1. Put your key in .env.local (NOT here):  ELEVEN_API_KEY=sk_...
#   2. Run  python audition_eleven.py  to audition voices + generate eleven-voices.json
#   3. Set MYRA_TTS=elevenlabs and restart the voice stack.
# MYRA_TTS=elevenlabs
# ELEVEN_MODEL=eleven_flash_v2_5
# ELEVEN_VOICE_ID=   # fallback voice if a persona isn't in eleven-voices.json

# GPU Parakeet STT (services/parakeet-stt) — primary speech recognition, ~15-25x
# faster than CPU Whisper and more accurate on the campaign's invented names.
# The agent falls back to the Whisper above if this service is unreachable.
# Set STT_ENGINE=whisper or blank PARAKEET_BASE_URL to disable and use Whisper only.
PARAKEET_BASE_URL=http://127.0.0.1:8767/v1
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v2
