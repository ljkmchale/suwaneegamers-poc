LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=suwanee-schedule
# Response-timing knobs (all optional; defaults shown).
# The worker also sends keep_alive=-1 on native preload and LLM requests.
OLLAMA_KEEP_ALIVE=-1
# Lower temperature = faster, more consistent, more accurate answers.
OLLAMA_TEMPERATURE=0.3
OLLAMA_TOP_P=0.9
# Turn-taking: lower = snappier replies, too low risks cutting the speaker off.
# These are also auto-tuned nightly from metrics; env vars act as manual overrides.
VAD_MIN_SILENCE=0.45
MIN_ENDPOINTING_DELAY=0.4
MAX_ENDPOINTING_DELAY=5.0

# Where the agent forwards per-turn timing metrics that feed the auto-tuner.
VOICE_METRICS_URL=http://127.0.0.1:4652/api/livekit/metrics

LOCAL_SPEECH_BASE_URL=http://127.0.0.1:8000/v1
# Must be NON-distilled: distil-whisper ignores the vocabulary prompt Myra
# sends for campaign/character names, and destabilizes on a long one.
LOCAL_STT_MODEL=Systran/faster-whisper-small.en
LOCAL_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
LOCAL_TTS_VOICE=af_heart
