# Google API key — Drive API must be enabled in Google Cloud Console
# Used by sync scripts to list Drive folder contents (no HTML scraping).
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=

# Shared Google Calendar
GOOGLE_CALENDAR_ID=g3kgagicusaol82fqhjc62o47o@group.calendar.google.com
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=g3kgagicusaol82fqhjc62o47o@group.calendar.google.com
NEXT_PUBLIC_GOOGLE_CALENDAR_COLOR=#fa573c
NEXT_PUBLIC_GOOGLE_CALENDAR_TIMEZONE=America/New_York

# Chronicles integration
# Local default is http://127.0.0.1:4317 when omitted.
BRAIN_QUERY_URL=http://127.0.0.1:4317

# Optional: enables Suwanee admin users to use Chronicles DM mode.
# Match this to DM_SHARED_SECRET in the brain-query service.
BRAIN_DM_SHARED_SECRET=

# Myra — local LiveKit voice assistant
# Local self-hosted LiveKit server.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_SCHEDULE_AGENT_NAME=myra
MYRA_FULL_DM_EMAILS=owner@example.com,co-owner@example.com

# Claude Platform statistics for /admin/voice-assistant.
# This must be a Console Admin API key, not Myra's normal Messages API key.
# Filter to Myra's dedicated key so unrelated organization usage is never shown.
ANTHROPIC_ADMIN_API_KEY=
MYRA_ANTHROPIC_API_KEY_ID=
