{
  "schemaVersion": 1,
  "canonicalGuide": "docs/AI_ARCHITECTURE.md",
  "runtime": {
    "developmentUrl": "http://localhost:3000",
    "productionUrl": "http://localhost:4652",
    "productionService": "SuwaneeGamers",
    "productionVersionEndpoint": "/api/version",
    "productionBuildMetadata": "BUILD_METADATA.json",
    "productionSlotPointer": "apps/web/.next-prod-active.json",
    "productionSlots": ["apps/web/.next-prod-a", "apps/web/.next-prod-b"]
  },
  "content": {
    "runtimeReader": "apps/web/lib/contentFiles.ts",
    "fileMirror": "content",
    "database": "content/suwaneegamers.db",
    "databaseFirstTable": "content_documents",
    "syncCommand": "pnpm content:sync-documents"
  },
  "media": {
    "imageDiskRoot": "apps/web/media/images",
    "imageUrlPrefix": "/media/images/",
    "imageRoute": "apps/web/app/media/images/[...segments]/route.ts",
    "audioDiskRoot": "apps/web/media/session-audio",
    "audioUrlPrefix": "/media/session-audio/",
    "audioRoute": "apps/web/app/media/session-audio/[...segments]/route.ts",
    "forbiddenGeneratedPrefixes": ["/images/"]
  },
  "chronicles": {
    "route": "apps/web/app/(site)/campaigns/[id]/chronicle/route.ts",
    "htmlRoot": "content/chronicles",
    "sync": "scripts/sync-chronicle.mjs",
    "storyRenderer": "scripts/lib/chronicle-story.mjs",
    "storyMaps": ["chronicle-poc/session-sequences.json", "sod-chronicle-poc/session-sequences.json"]
  },
  "voice": {
    "client": "apps/web/components/livekit/ScheduleVoiceAssistant.tsx",
    "tokenRoute": "apps/web/app/api/livekit/token/route.ts",
    "worker": "services/livekit-schedule-agent/src/schedule_agent/agent.py",
    "healthRegistry": "apps/web/lib/myraHealth.ts",
    "healthApi": "apps/web/app/api/myra/health/route.ts",
    "healthDashboard": "apps/web/app/admin/myra-health/page.tsx",
    "brainApi": "apps/web/app/api/brain/ask/route.ts",
    "sessionPublisher": "apps/web/brain-tools/src/sync-session-pages.mjs",
    "sessionFreshness": "apps/web/brain-data/session-freshness.json",
    "boundedPlanner": "services/livekit-schedule-agent/src/schedule_agent/planning.py",
    "fullDmVoiceAllowlist": "MYRA_FULL_DM_EMAILS",
    "campaignDmVoiceAssignments": "dungeon_masters / campaign_dms",
    "livekitPort": 7880,
    "speachesPort": 8000,
    "parakeetPort": 8767,
    "analyticsRoute": "/admin/voice-assistant"
  },
  "automation": {
    "scheduler": "scripts/content-scheduler.mjs",
    "myraHealthMonitor": "scripts/myra-health-monitor.mjs",
    "productionLauncher": "apps/web/scripts/start-prod.js"
  }
}
