# Copy this to .env.local for development, or .env for the Windows production host.

GOOGLE_CALENDAR_ID=g3kgagicusaol82fqhjc62o47o@group.calendar.google.com
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=g3kgagicusaol82fqhjc62o47o@group.calendar.google.com
NEXT_PUBLIC_GOOGLE_CALENDAR_COLOR=#fa573c
NEXT_PUBLIC_GOOGLE_CALENDAR_TIMEZONE=America/New_York

# Admin panel password (set this in .env.local / production env)
ADMIN_PASSWORD=change-me
# Admin session secret — must be at least 32 characters. Also signs the
# visitor sign-in cookie (sg-user).
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-32chars

# ----------------------------------------------------------------------------
# "Sign in with Google" for the public site.
# Create an OAuth 2.0 Client ID (type: Web application) at
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/google/callback     (dev)
#   https://suwaneegamers.net/api/auth/google/callback  (production)
# Sign-in is only ENFORCED when both values below are set; leave blank to
# keep the site open (e.g. before the OAuth client is created).
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: hard-code the external base URL used to build the OAuth redirect.
# Only needed if proxy headers don't resolve correctly.
# OAUTH_BASE_URL=https://suwaneegamers.net

# Myra checks the local origin and the public Cloudflare route separately.
# MYRA_WEBSITE_HEALTH_URL=http://127.0.0.1:4652/signin
# MYRA_CLOUDFLARE_HEALTH_URL=https://www.suwaneegamers.net/signin

# Google accounts allowed to log in to /admin (comma-separated). Empty = any
# account may attempt the password (allowlist disabled).
ADMIN_EMAILS=you@example.com,teammate@example.com
# Google accounts with full cross-campaign DM access through Myra. Other DMs
# automatically receive DM access only for campaigns currently assigned to them.
MYRA_FULL_DM_EMAILS=owner@example.com,co-owner@example.com
