# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
apps/web/.next/
apps/web/.next-prod/
# A/B deployment slots and their local state pointers. These are build output
# (~500MB each) plus machine-specific "which slot is live" markers, so they are
# never source. Only .next-prod/ was ignored before the A/B rollout, which left
# ~2.5GB of bundles staged for commit into a public repo.
apps/web/.next-prod-*
apps/web/.next-prod.incomplete-*
apps/web/out/
apps/web/media/session-audio/

# Environment files (never commit secrets)
.env
.env.local
.env.production.local
.env.development.local
.env.test.local

# SQLite database
*.db
*.db-journal
*.db-shm
*.db-wal
data/
apps/web/brain-data/
content/*-doc-cache.*

# Build outputs
dist/
build/
backups/

